              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Nubank PJ\",\n  \"tipo\": \"CORRENTE\",\n  \"saldoInicial\": 2000.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/contas/{{contaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contas",
                "{{contaId}}"
              ]
            }
