    },
    {
      "name": "Relatórios",
      "item": [
        {
          "name": "Relatório mensal",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/relatorios/mensal?ano=2026&mes=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "relatorios",
                "mensal"
              ],
              "query": [
                {
                  "key": "ano",
                  "value": "2026"
                },
                {
                  "key": "mes",
                  "value": "10"
                },
                {
                  "key": "contaId",
                  "value": "{{contaId}}",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Relatório do mês atual",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/relatorios/mensal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "relatorios",
                "mensal"
              ]
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}