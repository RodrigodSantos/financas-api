{
  "info": {
    "name": "Finanças API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "contaId",
      "value": ""
    },
    {
      "key": "transacaoId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "description": "Rode 'Login (demo)' primeiro: o token fica salvo e as outras requisições já o usam.",
      "item": [
        {
          "name": "Login (demo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@financas.local\",\n  \"senha\": \"demo1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Cadastro",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Seu Nome\",\n  \"email\": \"voce@email.com\",\n  \"senha\": \"senha-forte\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "cadastro"
              ]
            }
          }
        },
        {
          "name": "Login (usuário cadastrado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"voce@email.com\",\n  \"senha\": \"senha-forte\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Meus dados",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        {
          "name": "Listar categorias",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categorias?tipo=DESPESA&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "DESPESA"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Criar categoria",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('categoriaId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Pets\",\n  \"tipo\": \"DESPESA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias"
              ]
            }
          }
        },
        {
          "name": "Buscar categoria",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categorias/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias",
                "{{categoriaId}}"
              ]
            }
          }
        },
        {
          "name": "Atualizar categoria",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Pets e veterinário\",\n  \"tipo\": \"DESPESA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/categorias/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias",
                "{{categoriaId}}"
              ]
            }
          }
        },
        {
          "name": "Excluir categoria",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/categorias/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias",
                "{{categoriaId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Contas",
      "item": [
        {
          "name": "Listar contas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/contas?page=0&size=20",
              "host": [
