        {
          "name": "Atualizar transação",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Salário outubro + bônus\",\n  \"valor\": 5500.0,\n  \"tipo\": \"RECEITA\",\n  \"data\": \"2026-10-05\",\n  \"contaId\": {{contaId}},\n  \"categoriaId\": 1\n}",
              "options": {
