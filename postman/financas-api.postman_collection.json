{
  "info": {
    "name": "Finanças API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "contaId",
      "value": ""
    },
    {
      "key": "transacaoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Categorias",
      "item": [
        {
          "name": "Listar categorias",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categorias?tipo=DESPESA&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "DESPESA"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Criar categoria",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('categoriaId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Pets\",\n  \"tipo\": \"DESPESA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias"
              ]
            }
          }
        },
        {
          "name": "Buscar categoria",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categorias/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias",
                "{{categoriaId}}"
              ]
            }
          }
        },
        {
          "name": "Atualizar categoria",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Pets e veterinário\",\n  \"tipo\": \"DESPESA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categorias/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias",
                "{{categoriaId}}"
              ]
            }
          }
        },
        {
          "name": "Excluir categoria",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/categorias/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias",
                "{{categoriaId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Contas",
      "item": [
        {
          "name": "Listar contas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/contas?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contas"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "tipo",
                  "value": "CORRENTE",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Criar conta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('contaId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Nubank\",\n  \"tipo\": \"CORRENTE\",\n  \"saldoInicial\": 1500.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/contas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contas"
              ]
            }
          }
        },
        {
          "name": "Buscar conta",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/contas/{{contaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contas",
                "{{contaId}}"
              ]
            }
          }
        },
        {
          "name": "Atualizar conta",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Nubank PJ\",\n  \"tipo\": \"CORRENTE\",\n  \"saldoInicial\": 2000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/contas/{{contaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contas",
                "{{contaId}}"
              ]
            }
          }
        },
        {
          "name": "Excluir conta",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/contas/{{contaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contas",
                "{{contaId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transações",
      "description": "Rode antes 'Criar conta' (pasta Contas). A categoria 4 é 'Moradia' (DESPESA) e a 1 é 'Salário' (RECEITA).",
      "item": [
        {
          "name": "Listar transações",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transacoes?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transacoes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Registrar receita",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('transacaoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Salário outubro\",\n  \"valor\": 5000.0,\n  \"tipo\": \"RECEITA\",\n  \"data\": \"2026-10-05\",\n  \"contaId\": {{contaId}},\n  \"categoriaId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transacoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transacoes"
              ]
            }
          }
        },
        {
          "name": "Registrar despesa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Aluguel\",\n  \"valor\": 1500.0,\n  \"tipo\": \"DESPESA\",\n  \"data\": \"2026-10-05\",\n  \"contaId\": {{contaId}},\n  \"categoriaId\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transacoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transacoes"
              ]
            }
          }
        },
        {
          "name": "Despesa em categoria de receita (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Erro proposital\",\n  \"valor\": 10.0,\n  \"tipo\": \"DESPESA\",\n  \"data\": \"2026-10-05\",\n  \"contaId\": {{contaId}},\n  \"categoriaId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transacoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transacoes"
              ]
            }
          }
        },
        {
          "name": "Buscar transação",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transacoes/{{transacaoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transacoes",
                "{{transacaoId}}"
              ]
            }
          }
        },
        {
          "name": "Atualizar transação",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Salário outubro + bônus\",\n  \"valor\": 5500.0,\n  \"tipo\": \"RECEITA\",\n  \"data\": \"2026-10-05\",\n  \"contaId\": {{contaId}},\n  \"categoriaId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transacoes/{{transacaoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transacoes",
                "{{transacaoId}}"
              ]
            }
          }
        },
        {
          "name": "Excluir transação",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/transacoes/{{transacaoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transacoes",
                "{{transacaoId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}