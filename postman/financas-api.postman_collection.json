            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Erro proposital\",\n  \"valor\": 10.0,\n  \"tipo\": \"DESPESA\",\n  \"data\": \"2026-10-05\",\n  \"contaId\": {{contaId}},\n  \"categoriaId\": 1\n}",
