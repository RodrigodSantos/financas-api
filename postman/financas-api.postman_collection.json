        },
        {
          "name": "Excluir conta",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/contas/{{contaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contas",
                "{{contaId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transações",
      "description": "Rode antes 'Criar conta' (pasta Contas). A categoria 4 é 'Moradia' (DESPESA) e a 1 é 'Salário' (RECEITA).",
      "item": [
        {
          "name": "Listar transações",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transacoes?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transacoes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "inicio",
                  "value": "2026-10-01",
                  "disabled": true
                },
                {
                  "key": "fim",
                  "value": "2026-10-31",
                  "disabled": true
                },
                {
                  "key": "contaId",
                  "value": "{{contaId}}",
                  "disabled": true
                },
                {
                  "key": "categoriaId",
                  "value": "4",
                  "disabled": true
                },
                {
                  "key": "tipo",
                  "value": "DESPESA",
                  "disabled": true
                },
                {
                  "key": "descricao",
                  "value": "mercado",
                  "disabled": true
                }
              ]
            },
            "description": "Filtros opcionais e combináveis: ative os que quiser na aba Params."
          }
        },
        {
          "name": "Exportar CSV",
          "request": {
            "method": "GET",
            "description": "Aceita os mesmos filtros da listagem. No Postman, use 'Send and Download' para salvar o arquivo.",
            "url": {
              "raw": "{{baseUrl}}/api/transacoes/exportar?inicio=2026-10-01&fim=2026-10-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transacoes",
                "exportar"
              ],
              "query": [
                {
                  "key": "inicio",
                  "value": "2026-10-01"
                },
                {
                  "key": "fim",
                  "value": "2026-10-31"
                },
                {
                  "key": "tipo",
                  "value": "DESPESA",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Registrar receita",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('transacaoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Salário outubro\",\n  \"valor\": 5000.0,\n  \"tipo\": \"RECEITA\",\n  \"data\": \"2026-10-05\",\n  \"contaId\": {{contaId}},\n  \"categoriaId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/transacoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transacoes"
              ]
            }
          }
        },
        {
          "name": "Registrar despesa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
