            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Aluguel\",\n  \"valor\": 1500.0,\n  \"tipo\": \"DESPESA\",\n  \"data\": \"2026-10-05\",\n  \"contaId\": {{contaId}},\n  \"categoriaId\": 4\n}",
